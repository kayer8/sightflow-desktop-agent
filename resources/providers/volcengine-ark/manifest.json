{
  "apiVersion": 1,
  "id": "volcengine-ark",
  "name": "OpenAI-Compatible Chat Provider",
  "version": "1.0.0",
  "entry": "provider.bundle.js",
  "moduleType": "module",
  "capabilities": ["chat"],
  "configSchema": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "password",
        "title": "API Key"
      },
      "model": {
        "type": "string",
        "title": "Model",
        "default": "gpt-5.5"
      },
      "baseURL": {
        "type": "string",
        "title": "Base URL",
        "default": "https://api.openai.com/v1"
      },
      "systemPrompt": {
        "type": "string",
        "title": "System Prompt",
        "default": ""
      }
    },
    "required": ["apiKey"]
  }
}
